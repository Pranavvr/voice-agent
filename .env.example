# OpenAI — realtime voice session and the scope classifier
OPENAI_API_KEY=your_openai_api_key_here

# Model used by the scope gate (backend/app/guard.py). Runs once per turn on
# the critical path, so prefer a small, fast model.
CLASSIFIER_MODEL=gpt-5.6-luna
# Seconds to wait for the gate before failing open and letting the turn through.
CLASSIFIER_TIMEOUT_SECONDS=1.5

# PostgreSQL — note the variable name is DATABASE_URL, and the asyncpg driver
# is required. If this is unset the app silently falls back to local Docker
# Postgres, which surfaces as a connection error rather than a config error.
DATABASE_URL=postgresql+asyncpg://postgres:secretpassword@localhost:5432/voice_agent_db

# Redis — provisioned but not yet used by application code
REDIS_URL=redis://localhost:6379/0

# Tavily — required; backs the domain-locked f1_search tool
TAVILY_API_KEY=your_tavily_api_key_here

# --- RAG over the FIA regulations ---
# Embedding model for the regulation corpus. The full corpus is ~1,600 chunks
# (~125k tokens), so a rebuild costs well under a cent.
EMBEDDING_MODEL=text-embedding-3-small
# Build the regulation corpus on startup. Leave on for any real deployment;
# CI sets it false so tests do not download PDFs or spend embedding calls.
RAG_AUTO_INGEST=true
# Where the embedded Chroma index lives. Relative to the working directory, so
# this resolves to /app/chroma_index in the container. Gitignored, and rebuilt
# on startup whenever the collection is empty.
CHROMA_PATH=./chroma_index
# Regulation sources. Override when the FIA publishes a new issue — the issue
# number is parsed from the PDF and carried into citations.
FIA_SPORTING_URL=https://www.fia.com/system/files/documents/fia_2026_f1_regulations_-_section_b_sporting_-_iss_05_-_2026-02-27.pdf
FIA_TECHNICAL_URL=https://www.fia.com/sites/default/files/fia_2026_formula_1_technical_regulations_issue_8_-_2024-06-24.pdf
